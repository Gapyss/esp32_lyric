<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>company.g4pys.render-wrapper</string>

  <!-- Must be an interpreter with pyobjc-framework-{Quartz,CoreText,Cocoa}
       installed. /usr/bin/python3 does NOT have them; provision the venv per
       tools/requirements-render-wrapper.txt. -->
  <key>ProgramArguments</key>
  <array>
    <string>/Users/g4pys/esp-32/tools/.venv/bin/python3</string>
    <string>/Users/g4pys/esp-32/tools/g4pys_render_wrapper.py</string>
  </array>

  <key>EnvironmentVariables</key>
  <dict>
    <key>G4PYS_WRAPPER_HOST</key>
    <string>127.0.0.1</string>
    <key>G4PYS_WRAPPER_PORT</key>
    <string>8123</string>
    <key>G4PYS_DEVICE_URL</key>
    <string>http://g4pys-company.local</string>
    <key>G4PYS_RENDER_FONT</key>
    <string>Thonburi</string>
  </dict>

  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>

  <key>StandardOutPath</key>
  <string>/tmp/g4pys.company-render-wrapper.out.log</string>
  <key>StandardErrorPath</key>
  <string>/tmp/g4pys.company-render-wrapper.err.log</string>
</dict>
</plist>
