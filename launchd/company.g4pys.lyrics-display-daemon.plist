<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>company.g4pys.lyrics-display-daemon</string>

  <key>ProgramArguments</key>
  <array>
    <!-- Must be an interpreter with pyobjc-framework-CoreText installed.
         The daemon falls back to geometry-only frames without it, which means
         the board receives rules/progress pixels but no rendered text. -->
    <string>/Users/g4pys/esp-32/tools/.venv/bin/python3</string>
    <string>/Users/g4pys/esp-32/daemon/lyrics_display_daemon.py</string>
    <string>serve</string>
  </array>

  <key>WorkingDirectory</key>
  <string>/Users/g4pys/esp-32</string>

  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>

  <key>StandardOutPath</key>
  <string>/Users/g4pys/Library/Logs/g4pys-lyrics-display-daemon.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/g4pys/Library/Logs/g4pys-lyrics-display-daemon.err.log</string>

  <key>EnvironmentVariables</key>
  <dict>
    <key>PYTHONUNBUFFERED</key>
    <string>1</string>
    <key>G4PYS_LYRICS_DB</key>
    <string>/Users/g4pys/.g4pys/lyrics-display.sqlite3</string>
  </dict>
</dict>
</plist>
