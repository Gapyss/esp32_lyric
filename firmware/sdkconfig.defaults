# This file was generated using idf.py save-defconfig. It can be edited manually.
# Espressif IoT Development Framework (ESP-IDF) 5.5.1 Project Minimal Configuration
#
CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_HTTPD_MAX_REQ_HDR_LEN=512
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_FATFS_LFN_HEAP=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y
CONFIG_FREERTOS_HZ=1000

# Power management. DFS only -- main.cpp keeps light sleep off because the
# USB-Serial/JTAG console holds a PM lock whenever a host is attached.
# Deliberately no CONFIG_PM_DFS_INIT_AUTO: it would install a DFS config using
# the XTAL as the minimum before power_management_start() runs, and this module
# has octal PSRAM that should not drop below 80 MHz.
CONFIG_PM_ENABLE=y
# Log level deliberately left at the default. Dropping it to WARN was tried and
# reverted: USB-Serial/JTAG output only blocks while a host is attached, which
# is exactly when the board is not on battery, so it saves nothing on battery
# while hiding the pairing and network diagnostics this project relies on.
